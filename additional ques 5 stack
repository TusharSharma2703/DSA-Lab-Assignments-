#include <iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    int A[n];
    for(int i=0;i<n;i++) cin>>A[i];
    int st[n],top=-1;
    int want=1;
    for(int i=0;i<n;i++){
        st[++top]=A[i];
        while(top!=-1 && st[top]==want){
            top--;
            want++;
        }
    }
    cout<<(want==n+1?"YES":"NO");
}
