#include <iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    int a[n],st[n],top=-1;
    for(int i=0;i<n;i++) cin>>a[i];
    for(int i=0;i<n;i++){
        while(top!=-1 && st[top]>=a[i]) top--;
        if(top==-1) cout<<-1<<" ";
        else cout<<st[top]<<" ";
        st[++top]=a[i];
    }
}
