#include <bits/stdc++.h>
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<int>a(n);
    for(int i=0;i<n;i++) cin>>a[i];
    int count2=0;
    for(int i=0;i<n;i++) if(a[i]==2) count2++;
    for(int i=n-1;i>=0;i--){
        int j=i+count2;
        if(j<n) a[j]=a[i];
        if(a[i]==2){
            count2--;
            j=i+count2;
            if(j<n) a[j]=2;
        }
    }
    for(int i=0;i<n;i++) cout<<a[i]<<" ";
}
