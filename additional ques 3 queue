#include <iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    int q[100];
    for(int i=0;i<n;i++) cin>>q[i];
    int st[100],top=-1;
    int want=1,f=0;
    while(f<n){
        if(q[f]==want){ want++; f++; }
        else if(top!=-1 && st[top]==want){ top--; want++; }
        else st[++top]=q[f++];
    }
    while(top!=-1 && st[top]==want){ top--; want++; }
    cout<<(want==n+1?"Yes":"No");
}
