
#include <iostream>
using namespace std;

int heapArr[100];
int heapSize = 0;

int parent(int i){ return (i - 1) / 2; }
int left(int i){ return 2 * i + 1; }
int right(int i){ return 2 * i + 2; }

void insertValue(int x){
    heapArr[heapSize] = x;
    int i = heapSize;
    heapSize++;

    while (i != 0 && heapArr[parent(i)] < heapArr[i]) {
        swap(heapArr[i], heapArr[parent(i)]);
        i = parent(i);
    }
}

int getMax(){
    if (heapSize == 0) return -1;
    return heapArr[0];
}

void heapify(int i){
    int largest = i;
    int l = left(i);
    int r = right(i);

    if (l < heapSize && heapArr[l] > heapArr[largest])
        largest = l;
    if (r < heapSize && heapArr[r] > heapArr[largest])
        largest = r;

    if (largest != i) {
        swap(heapArr[i], heapArr[largest]);
        heapify(largest);
    }
}

void deleteMax(){
    if (heapSize == 0) return;

    cout << "Deleted: " << heapArr[0] << endl;

    heapArr[0] = heapArr[heapSize - 1];
    heapSize--;
    heapify(0);
}

void display(){
    if (heapSize == 0){
        cout << "Empty\n";
        return;
    }
    for (int i = 0; i < heapSize; i++)
        cout << heapArr[i] << " ";
    cout << endl;
}

int main(){
    int choice, x;
    while (true){
        cin >> choice;
        switch (choice){
            case 1: cin >> x; insertValue(x); break;
            case 2: cout << getMax() << endl; break;
            case 3: deleteMax(); break;
            case 4: display(); break;
            case 5: return 0;
        }
    }
}
