#include <iostream>
using namespace std;

struct DNode {
    char data;
    DNode* prev;
    DNode* next;
};

DNode* head = NULL;

void insertLast(char c) {
    DNode* n = new DNode{ c, NULL, NULL };
    if (!head) {
        head = n;
        return;
    }
    DNode* temp = head;
    while (temp->next) temp = temp->next;
    temp->next = n;
    n->prev = temp;
}

bool isPalindrome() {
    if (!head || !head->next) return true;
    DNode* left = head;
    DNode* right = head;
    while (right->next) right = right->next;
    while (left != right && right->next != left) {
        if (left->data != right->data) return false;
        left = left->next;
        right = right->prev;
    }
    return true;
}

int main() {
    string s;
    cin >> s;
    for (char c : s) insertLast(c);
    if (isPalindrome()) cout << "Palindrome\n";
    else cout << "Not Palindrome\n";
    return 0;
}
