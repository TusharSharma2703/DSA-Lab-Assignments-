#include <iostream>
using namespace std;

bool isSubstring(string &a, string &b) {
    for (int i = 0; i + a.size() <= b.size(); i++) {
        int k = 0;
        while (k < a.size() && b[i + k] == a[k]) k++;
        if (k == a.size()) return true;
    }
    return false;
}

int main() {
    string s;
    cin >> s;
    int n = s.size();
    bool ok = false;
    for (int i = 1; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            string a = "";
            string b = "";
            string c = "";
            for (int x = 0; x < i; x++) a += s[x];
            for (int x = i; x < j; x++) b += s[x];
            for (int x = j; x < n; x++) c += s[x];
            if ((isSubstring(b, a) && isSubstring(b, c)) ||
                (isSubstring(a, b) && isSubstring(a, c)) ||
                (isSubstring(c, a) && isSubstring(c, b))) {
                ok = true;
                break;
            }
        }
        if (ok) break;
    }
    cout << (ok ? "YES" : "NO");
}
