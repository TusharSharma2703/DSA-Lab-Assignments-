#include <bits/stdc++.h>
using namespace std;
int main(){
    int n,k;
    cin>>n>>k;
    vector<int>a(n);
    for(int i=0;i<n;i++) cin>>a[i];
    sort(a.begin(),a.end());
    int i=0,j=1,cnt=0;
    while(j<n){
        int diff=a[j]-a[i];
        if(diff==k){
            cnt++;
            i++;
            j++;
        }
        else if(diff>k) i++;
        else j++;
        if(i==j) j++;
    }
    cout<<cnt;
}
