#include <iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    int t[n],st[n],idx[n],top=-1,res[n];
    for(int i=0;i<n;i++) cin>>t[i];
    for(int i=n-1;i>=0;i--){
        while(top!=-1 && t[i]>=st[top]) top--;
        if(top==-1) res[i]=0; else res[i]=idx[top]-i;
        st[++top]=t[i];
        idx[top]=i;
    }
    for(int i=0;i<n;i++) cout<<res[i]<<" ";
}
