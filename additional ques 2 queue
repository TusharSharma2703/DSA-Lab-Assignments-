#include <iostream>
#include <climits>
using namespace std;
int main(){
    int n;
    cin>>n;
    int q[100];
    for(int i=0;i<n;i++) cin>>q[i];
    for(int i=0;i<n;i++){
        int minIndex=-1,minVal=INT_MAX;
        for(int j=0;j<n-i;j++){
            if(q[j]<minVal){ minVal=q[j]; minIndex=j; }
        }
        for(int j=minIndex;j<n-i-1;j++) q[j]=q[j+1];
        q[n-i-1]=minVal;
    }
    for(int i=0;i<n;i++) cout<<q[i]<<" ";
}
